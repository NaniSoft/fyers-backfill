# Fyers API v3 credentials — copy this file to .env and fill in real values.
# NEVER commit .env. (A .gitignore already excludes it.)
# Obtain these from the Fyers developer portal (your registered v3 app).

FYERS_APP_ID=XXXXXXXXXX
FYERS_SECRET_ID=your_app_secret_here
# The redirect_uri you registered on the Fyers app — byte-exact, no query
# string (a mismatch bounces silently back to the login page). Local k8s
# token-service deployment: http://127.0.0.1:8001/callback (port 8001 is
# pinned by the Fyers app registration AND the LoadBalancer Service).
# The callback listener port is derived from this URI; FYERS_CALLBACK_PORT
# below is legacy/unused.
FYERS_REDIRECT_URI=http://127.0.0.1:8001/callback
# Legacy: unused (port derives from FYERS_REDIRECT_URI).
FYERS_CALLBACK_PORT=8001

# --- Unattended (headless) Fyers web login — legacy path only ---
# The token service does NOT need these: the user supplies TOTP/PIN on
# Fyers' own page (click-flow auth). Kept until the headless path retires.
FYERS_LOGIN_ID=your_fyers_login_id
FYERS_PASSWORD=your_fyers_password
FYERS_PIN=123456
FYERS_TOTP_SECRET=your_base32_totp_secret

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=123456:abcdef
TELEGRAM_CHAT_ID=987654321

# --- Google Drive backup (rclone remote) ---
GDRIVE_REMOTE=gdrive
GDRIVE_PATH=fyers-snapshots